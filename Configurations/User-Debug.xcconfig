#include "Base.xcconfig"

COPY_PHASE_STRIP = NO
DEBUG_INFORMATION_FORMAT = dwarf
ENABLE_TESTABILITY = YES
GCC_OPTIMIZATION_LEVEL = 0
ONLY_ACTIVE_ARCH = YES
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) DEBUG
SWIFT_OPTIMIZATION_LEVEL = -Onone

EXCLUDED_SOURCE_FILE_NAMES = $(inherited) SingleGreenInternalCapabilities.txt
SG_APP_BUNDLE_IDENTIFIER = com.local.SingleGreenDemo
SG_APP_DISPLAY_NAME = 单绿测试平台
SG_TEST_BUNDLE_IDENTIFIER = com.local.SingleGreenDemoTests
