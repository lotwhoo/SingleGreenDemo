{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://single-green.invalid/schemas/release-evidence-v1.json",
  "title": "SingleGreenDemo release evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "version", "commit", "generatedAt", "workingTreeDirty", "automated", "manual", "residualRisks"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "version": { "type": "string", "minLength": 1 },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "workingTreeDirty": { "type": "boolean" },
    "automated": { "$ref": "#/$defs/automatedChecks" },
    "manual": { "$ref": "#/$defs/manualChecks" },
    "residualRisks": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "status": {
      "enum": ["not_run", "passed", "failed", "blocked"]
    },
    "automatedChecks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packageStrictGate", "asrCLIPrivacyBuild", "appSimulatorTests", "releaseSimulatorBuild", "coverageGate", "secretScan"],
      "properties": {
        "packageStrictGate": { "$ref": "#/$defs/status" },
        "asrCLIPrivacyBuild": { "$ref": "#/$defs/status" },
        "appSimulatorTests": { "$ref": "#/$defs/status" },
        "releaseSimulatorBuild": { "$ref": "#/$defs/status" },
        "coverageGate": { "$ref": "#/$defs/status" },
        "secretScan": { "$ref": "#/$defs/status" }
      }
    },
    "manualChecks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["physicalDevice", "realServices", "accessibility", "opticalCalibration"],
      "properties": {
        "physicalDevice": { "$ref": "#/$defs/status" },
        "realServices": { "$ref": "#/$defs/status" },
        "accessibility": { "$ref": "#/$defs/status" },
        "opticalCalibration": { "$ref": "#/$defs/status" }
      }
    }
  }
}
